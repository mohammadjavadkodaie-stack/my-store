DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
# کلید امضای JWT — حداقل 32 کاراکتر تصادفی؛ سرور بدون مقدار معتبر اجرا نمی‌شود
# ساخت مقدار: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# اعتبار توکن JWT (پیش‌فرض: 2h) — مثل 30s / 15m / 2h / 7d یا ثانیه‌ی خام
JWT_EXPIRES_IN=2h
# ساخت ادمین با seed — فقط وقتی مقدار تنظیم شده باشد اجرا می‌شود (شماره موبایل ایران)
SEED_ADMIN_PHONE=
# شماره‌ی مالک سایت (صاحب کلید سراسری روشن/خاموش) — فقط در بک‌اند و .env
# قالب‌های پذیرفته‌شده: 09xxxxxxxxx ، +989xxxxxxxxx ، 00989xxxxxxxxx ، 989xxxxxxxxx
# این مقدار هرگز در پاسخ API یا لاگ چاپ نمی‌شود.
OWNER_PHONE=
# سوئیچ فقط-توسعه: با مقدار true هر کد ۶ رقمی پذیرفته می‌شود — dev only, never true in production
OTP_DEV_BYPASS=
